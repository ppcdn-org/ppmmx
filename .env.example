# Copy this file to .env (or bin/.env when running from bin/) and fill in
# real values for your deployment. .env is gitignored - never commit it.
# Loaded by internal/conf/dotenv.go: real process env vars always win over
# .env; if a var isn't in the environment, dotenv.go walks up from the
# working directory looking for a .env file with that key.

# Runtime environment: local | dev | test | uat | stag | prod
APP_ENV=local

# ── Admin login fallback ─────────────────────────────────────────
# Used only until an admin account is set through the admin store; once one
# exists, these are ignored. Leave unset in production once you've set a
# real account.
MMXADMIN_USERNAME=admin
MMXADMIN_PASSWORD=change-me

# ── Backup / multitrack player domain ────────────────────────────
# Shown in the admin UI's player-domain config and used to build backup
# play URLs. Falls back to the node's own main domain if unset.
BACKUP_PLAYER_DOMAIN=

# ── Legacy health-check path ──────────────────────────────────────
# Off by default. Set only if an existing load balancer/monitor already
# points at a specific legacy path (e.g. "/lotto/health") you can't change
# on the caller's side.
LEGACY_HEALTH_PATH=

# ── Video-stat reporting integration (optional, per-environment) ──
# Third-party stat-collection API base URL for each named environment. Any
# left empty just means that environment has no videostat integration.
VIDEOSTAT_URL_TEST=
VIDEOSTAT_URL_UAT=
VIDEOSTAT_URL_STAG=
VIDEOSTAT_URL_PROD=

# ── Tencent Cloud WHIP/RTMP anti-leech signing ───────────────────
# Signs outbound Tencent Cloud forward/ingest URLs and backup play links
# (see internal/forward/tencent.go, internal/ingest, admin.signedPlayParams).
TX_SECRET_KEY=
TX_SECRET_KEY_BACK=

# ── WHIP publish auth (docs/obs-whip-publish-auth-protocol.md) ───
# AES key checkWHIPDeviceID uses to decrypt the ppcenter-issued bearer token
# every WHIP publish request must carry (see ppcenter's whipAuth.authKey -
# both sides must be provisioned with the identical value). The same token
# also authenticates the degrade-protocol control WebSocket
# (docs/obs-mmx-degrade-protocol.md), so no separate secret is needed. No
# insecure default: unset means every WHIP publish is rejected with 403.
WHIP_AUTH_KEY=

# ── mmx-to-mmx forwarding auth (checkWHIPDeviceID, forwardMmx) ───
# Static pre-shared secret checkWHIPDeviceID also accepts, for forwardMmx
# pushes between your own trusted nodes (internal/forward/mmx.go) - set the
# identical value on every node that forwards to, or receives a forward
# from, another node. Every forwardMmx target that doesn't spell out a token
# of its own picks this up automatically (see conf.Path.validate), so the
# secret never has to be written into a config file. Independent of
# WHIP_AUTH_KEY (external ppobs publishers) - never reuse either. No
# insecure default.
MMX_FORWARD_SECRET=

# ── ppcenter node control plane (mmxControl) ─────────────────────
# Authenticates this node to ppcenter's /ws/mmx node channel, sent as
# "Authorization: Bearer <token>" on both the WebSocket dial and the HTTP
# heartbeat fallback. Must match ppcenter's nodeAuth.bearerToken (or one of
# its nodeAuth.nodeTokens). Required whenever mmxControl is true - ppcenter
# answers an unauthenticated dial with 401 unauthorized_node, so the node
# never registers and no publish is ever routed to it.
# Unrelated to WHIP_AUTH_KEY: that is the key ppcenter encrypts publish
# tokens with; this is how ppcenter recognises the node itself. Also
# authenticates the 30s app-credentials sync (see
# internal/mmxcontrol/app_sync.go) that split-rec's own token auth (POST
# /api/record/split, "simple"/"advance" mode - see internal/conf.go's
# splitRecAuthMode) now verifies against instead of a separate deployment
# secret: mmx checks a split-rec request's signature using the calling
# appId's own appSecret, synced here.
MMX_NODE_SECRET=

# ── Recording rate limit ─────────────────────────────────────────
# Requests per minute per source IP for /api/playUri and /api/play(Tx)?Url.
# Blank/invalid falls back to the built-in default (30).
PLAY_URI_RATE_LIMIT=

# ── S3-compatible object storage (recording upload) ──────────────
# Once S3 is configured, it's used for every split-rec upload regardless of
# "appEnv" - there's no per-environment bucket (e.g. OVH net-storage only
# ever has the one ppcdn-net-storage bucket). A request that sends a
# non-empty appEnv instead gets an "<appEnv>/" object-key prefix within this
# same bucket; a request that omits appEnv gets a plain, unprefixed key (no
# fallback to this APP_ENV setting for that prefix). MinIO below is only
# used as a fallback when S3 isn't configured at all.
S3_REGION=
S3_BUCKET=
S3_ACCESS_ID=
S3_ACCESS_PASS=
S3_HTTPS_DOMAIN=
# Optional: custom S3 API endpoint for an S3-compatible provider (e.g. OVH:
# https://s3.sgp.io.cloud.ovh.net). Leave empty to use AWS S3 for S3_REGION.
# Set this here rather than exporting AWS_ENDPOINT_URL_S3 in the process env -
# all S3 settings stay in one place. A trailing slash is tolerated.
S3_ENDPOINT_URL=
# Optional: canned ACL sent with every uploaded object, e.g. "public-read" or
# "private" (see AWS's ObjectCannedACL for the full list). Leave empty to
# send no ACL header at all, in which case the object's public/private-ness
# is whatever the bucket's own default ACL/policy says - the original,
# implicit behavior from before this setting existed.
S3_ACL=

# ── MinIO object storage (alternative to S3 above) ────────────────
MINIO_EP=
MINIO_AK=
MINIO_SK=
MINIO_USESSL=
MINIO_URL=

# ── Nacos remote config (optional) ────────────────────────────────
# Entirely opt-in: only attempted if BOOTSTRAP_JASYPT_ENCRYPTOR_PASSWORD is
# set. Currently only used to fetch MinIO settings at startup; Nacos
# outages are logged and ignored, never block startup.
BOOTSTRAP_JASYPT_ENCRYPTOR_PASSWORD=
BOOTSTRAP_NACOS_CONFIG_SERVER=
BOOTSTRAP_NACOS_CONFIG_SERVER_PORT=
BOOTSTRAP_NACOS_CONFIG_USERNAME=
BOOTSTRAP_NACOS_CONFIG_PASSWORD=
BOOTSTRAP_NACOS_CONFIG_NAMESPACE=
# dataId this service's config is published under. Defaults to "mmx" if unset.
BOOTSTRAP_NACOS_CONFIG_DATA_ID=
